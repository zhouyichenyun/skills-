{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio production plan v1",
  "type": "object",
  "required": ["version", "duration", "tracks"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string"},
    "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "sample_rate": {"const": 48000},
    "channels": {"const": 2},
    "target_lufs": {"type": "number", "minimum": -30, "maximum": -9},
    "true_peak_db": {"type": "number", "minimum": -9, "maximum": -0.1},
    "ducking": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "threshold_db": {"type": "number", "minimum": -60, "maximum": 0},
        "ratio": {"type": "number", "minimum": 1, "maximum": 20},
        "attack_ms": {"type": "number", "minimum": 0.01, "maximum": 2000},
        "release_ms": {"type": "number", "minimum": 0.01, "maximum": 9000}
      }
    },
    "tracks": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["role", "source", "duration"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["dialogue", "voiceover", "music", "sfx", "ambience"]},
        "source": {"type": "string", "minLength": 1},
        "at": {"type": "number", "minimum": 0},
        "source_start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "gain_db": {"type": "number", "minimum": -90, "maximum": 24},
        "fade_in": {"type": "number", "minimum": 0},
        "fade_out": {"type": "number", "minimum": 0},
        "loop": {"type": "boolean"},
        "duck": {"type": "boolean"}
      }
    }}
  },
  "$comment": "Runtime also checks actual audio availability/ranges, IDs, finite values, timeline bounds, role-specific looping/ducking, fade ranges, sample-grid length and non-destructive output."
}
