{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI production project v1",
  "type": "object",
  "required": ["version", "id", "kind", "steps"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
    "kind": {"enum": ["talking_head", "story", "mixed"]},
    "brief": {"type": "object"},
    "permissions": {"type": "object", "properties": {"generate_media": {"type": "boolean"}}},
    "limits": {
      "type": "object",
      "properties": {
        "max_generation_calls": {"type": "integer", "minimum": 0},
        "max_generation_credits": {"type": "number", "minimum": 0},
        "max_repair_rounds": {"type": "integer", "minimum": 0},
        "max_attempts_per_input": {"type": "integer", "minimum": 1}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
          "kind": {"enum": ["local", "agent", "provider", "review"]},
          "action": {"type": "string", "minLength": 1},
          "needs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "params": {"type": "object"},
          "expected_media": {"enum": ["image", "video", "audio"]},
          "required_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$comment": "Runtime additionally validates DAG cycles, ancestor references, input/media existence, attempt outputs, budget reservations, real receipts, hashes and review subjects. Schema validity is not production acceptance."
}
